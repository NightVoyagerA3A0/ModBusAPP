<Window x:Class="ModBusAPP.GUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="点位研究用例" Height="350" Width="500">

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#F5F5F5" Padding="5">
            <MenuItem Header="文件(F)" />
            <MenuItem Header="编辑(E)" />
            <MenuItem Header="通信设置(C)" />
            <MenuItem Header="帮助(H)" />
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Background="Yellow">
            <StatusBarItem>
                <TextBlock Text="等待中" Foreground="Black" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="125" MinWidth="125" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#EEEEEE" BorderBrush="#CCC" BorderThickness="0,0,1,0">
                <CheckBox Content="CheckBox" Margin="0,0,0,0"/>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <Grid Grid.Column="2" Background="White">
                <TextBlock Text="这里是实时监控数据区" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#AAA" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>